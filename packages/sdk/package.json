{
  "name": "@upmetrics/sdk",
  "version": "0.3.1",
  "description": "Upmetrics error-tracking SDK for browser/node/bun \u2014 Sentry-envelope compatible, PII-scrubbed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/upmetrics.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "build": "node scripts/gen-version.mjs && tsc",
    "typecheck": "node scripts/gen-version.mjs && tsc --noEmit",
    "test": "bun test test/"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

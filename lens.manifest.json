{
  "project": "upmetrics",
  "base_url": "https://upmetrics.org",
  "auth": { "adapter": "storageState", "statePath": ".lens/storage-state.json" },
  "surfaces": [
    { "name": "overview", "path": "/", "mode": "element", "selector": "[data-testid=\"overview-root\"]", "waitFor": "[data-testid=\"overview-root\"]", "baseline_key": "overview" },
    { "name": "issues", "path": "/issues", "mode": "element", "selector": "[data-testid=\"issues-root\"]", "waitFor": "[data-testid=\"issues-root\"]" },
    { "name": "agents", "path": "/agents", "mode": "element", "selector": "[data-testid=\"agents-root\"]", "waitFor": "[data-testid=\"agents-root\"]" },
    { "name": "probes", "path": "/probes", "mode": "element", "selector": "[data-testid=\"probes-root\"]", "waitFor": "[data-testid=\"probes-root\"]" },
    { "name": "incidents", "path": "/incidents", "mode": "element", "selector": "[data-testid=\"incidents-root\"]", "waitFor": "[data-testid=\"incidents-root\"]" },
    { "name": "remediation", "path": "/remediation", "mode": "element", "selector": "[data-testid=\"remediation-root\"]", "waitFor": "[data-testid=\"remediation-root\"]" },
    { "name": "project-detail", "path": "/projects/upmetrics", "mode": "element", "selector": "[data-testid=\"project-detail-root\"]", "waitFor": "[data-testid=\"project-detail-root\"]", "assert": "const t=document.querySelector('[data-testid=\"project-detail-root\"]').innerText; return { pass: /sdk\\s*0\\.1\\.4/.test(t), detail: (t.match(/upmetrics-server[^\\n]*/)||[''])[0] }" }
  ]
}

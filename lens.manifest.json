{
  "project": "upmetrics",
  "base_url": "https://upmetrics.org",
  "auth": { "adapter": "mintEndpoint", "url": "https://upmetrics.org/api/lens-session", "secretPath": ".lens/mint-secret" },
  "surfaces": [
    { "name": "overview", "path": "/", "mode": "element", "selector": "[data-testid=\"overview-root\"]", "waitFor": "[data-testid=\"overview-root\"]", "no_diff": true, "assert": "return { pass: document.querySelector('[data-testid=\"overview-root\"]').innerText.includes('Health across all projects') }" },
    { "name": "issues", "path": "/issues", "mode": "element", "selector": "[data-testid=\"issues-root\"]", "waitFor": "[data-testid=\"issues-root\"]", "no_diff": true },
    { "name": "agents", "path": "/agents", "mode": "element", "selector": "[data-testid=\"agents-root\"]", "waitFor": "[data-testid=\"agents-root\"]", "no_diff": true },
    { "name": "probes", "path": "/probes", "mode": "element", "selector": "[data-testid=\"probes-root\"]", "waitFor": "[data-testid=\"probes-root\"]", "no_diff": true },
    { "name": "deploys", "path": "/deploys", "mode": "element", "selector": "[data-testid=\"deploys-root\"]", "waitFor": "[data-testid=\"deploys-root\"]", "no_diff": true, "assert": "return { pass: document.querySelector('[data-testid=\"deploys-root\"]').innerText.includes('Deploys') }" },
    { "name": "ci", "path": "/ci", "mode": "element", "selector": "[data-testid=\"ci-root\"]", "waitFor": "[data-testid=\"ci-root\"]", "no_diff": true, "assert": "return { pass: document.querySelector('[data-testid=\"ci-root\"]').innerText.includes('CI') }" },
    { "name": "incidents", "path": "/incidents", "mode": "element", "selector": "[data-testid=\"incidents-root\"]", "waitFor": "[data-testid=\"incidents-root\"]", "no_diff": true },
    { "name": "remediation", "path": "/remediation", "mode": "element", "selector": "[data-testid=\"remediation-root\"]", "waitFor": "[data-testid=\"remediation-root\"]", "no_diff": true },
    { "name": "project-detail", "path": "/projects/upmetrics", "mode": "element", "selector": "[data-testid=\"project-detail-root\"]", "waitFor": "[data-testid=\"project-detail-root\"]", "no_diff": true, "assert": "const t=document.querySelector('[data-testid=\"project-detail-root\"]').innerText; return { pass: /sdk\\s*\\d+\\.\\d+\\.\\d+/.test(t), detail: (t.match(/upmetrics-server[^\\n]*/)||[''])[0] }" },
    { "name": "credentials-card", "path": "/projects/upmetrics", "mode": "element", "selector": "[data-testid=\"credentials-card\"]", "waitFor": "[data-testid=\"credentials-card\"]", "assert": "return { pass: document.querySelector('[data-testid=\"credentials-card\"]').innerText.includes('UPMETRICS_API_KEY') }" }
  ],
  "flows": [
    {
      "name": "dashboard-smoke",
      "base_url": "https://upmetrics.org",
      "mutates": false,
      "steps": [
        { "type": "goto", "path": "/" },
        { "type": "expectVisible", "testid": "overview-root" },
        { "type": "screenshot", "label": "overview" },
        { "type": "goto", "path": "/issues" },
        { "type": "expectVisible", "testid": "issues-root" },
        { "type": "screenshot", "label": "issues" },
        { "type": "goto", "path": "/agents" },
        { "type": "expectVisible", "testid": "agents-root" },
        { "type": "goto", "path": "/probes" },
        { "type": "expectVisible", "testid": "probes-root" },
        { "type": "goto", "path": "/incidents" },
        { "type": "expectVisible", "testid": "incidents-root" },
        { "type": "goto", "path": "/remediation" },
        { "type": "expectVisible", "testid": "remediation-root" },
        { "type": "goto", "path": "/projects/upmetrics" },
        { "type": "expectVisible", "testid": "project-detail-root" },
        { "type": "screenshot", "label": "project-detail" }
      ]
    },
    {
      "name": "project-admin",
      "base_url": "https://upmetrics.org",
      "mutates": false,
      "steps": [
        { "type": "goto", "path": "/" },
        { "type": "expectVisible", "testid": "overview-root" },
        { "type": "click", "testid": "new-project-btn" },
        { "type": "expectVisible", "testid": "new-project-name" },
        { "type": "screenshot", "label": "new-project-modal" },
        { "type": "goto", "path": "/projects/upmetrics" },
        { "type": "expectVisible", "testid": "credentials-card" },
        { "type": "click", "testid": "cred-reveal-btn" },
        { "type": "screenshot", "label": "credentials-revealed" }
      ]
    }
  ]
}
